---
/**
 * Star map page — canvas engine adapted from thunfischtoast/bobiverse-map
 * (CC BY-SA 4.0). See LICENSE-star-map.md and the engine file header.
 */
import Layout from "../layouts/Layout.astro";
import BookToggle from "../components/BookToggle.astro";
import { buildStarMapPayload } from "../data/starMapAdapter";
import { unplottableNote } from "../data/starMapMeta";

const payload = buildStarMapPayload();
const payloadJson = JSON.stringify(payload);
---

<Layout
  title="Star map · Bobiverse Companion"
  description="Interactive Bobiverse star map (books 1–2), adapted from thunfischtoast/bobiverse-map."
  fullscreen
>
  <div class="star-map-app" data-star-map-app>
    <div class="top-bar">
      <h1>Bobiverse Star Map</h1>
      <span class="year-display" data-sm-year>{payload.yearMin}</span>
      <button type="button" class="layout-btn" data-sm-layout>Layout: Spread</button>
      <div class="top-bar-right">
        <BookToggle />
        <button
          type="button"
          class="about-btn"
          data-about-btn
          aria-expanded="false"
          aria-controls="star-map-about"
        >
          About
        </button>
      </div>
    </div>

    <div class="about-panel hidden" id="star-map-about" data-about-panel role="dialog" aria-label="About this star map">
      <p>
        Interactive map of star systems and Bob locations for books 1–2. Positions use
        catalog astrometry from this companion’s dataset. Travel legs, presence years,
        event-log wording, spread layout, and the canvas renderer are
        <strong>adapted</strong> from
        <a href="https://github.com/thunfischtoast/bobiverse-map" rel="noopener noreferrer" target="_blank"
          >thunfischtoast/bobiverse-map</a
        >
        by Chris (CC BY-SA 4.0) — see <code>LICENSE-star-map.md</code>.
      </p>
      <p class="faint">{unplottableNote}</p>
      <p class="faint">Unofficial fan project. Not affiliated with Dennis E. Taylor.</p>
    </div>

    <div class="main">
      <div class="map-container" data-sm-map>
        <canvas data-sm-canvas></canvas>
        <div class="tooltip" data-sm-tooltip></div>
        <div class="legend" data-sm-legend></div>
      </div>

      <aside class="side-column">
        <div class="event-panel">
          <h2>Event Log</h2>
          <div class="event-log" data-sm-event-log></div>
        </div>
        <div class="system-panel" data-system-panel data-open="false" aria-hidden="true">
          <div class="system-panel-header">
            <div>
              <p class="eyebrow">Selected system</p>
              <h2 data-detail-name>—</h2>
              <p class="distance" data-detail-distance></p>
            </div>
            <button type="button" class="close-btn" data-drawer-close aria-label="Close">✕</button>
          </div>
          <p class="description" data-detail-description></p>
          <p class="eyebrow">Bobs here</p>
          <ul data-detail-bobs>
            <li class="faint">—</li>
          </ul>
        </div>
      </aside>
    </div>

    <div class="timeline">
      <label>YEAR</label>
      <input
        type="range"
        data-sm-slider
        min={payload.yearMin}
        max={payload.yearMax}
        step="0.1"
        value={payload.yearMin}
      />
      <button type="button" data-sm-play>Play</button>
      <span class="speed-display" data-sm-speed>2.0 yr/s</span>
    </div>
  </div>
</Layout>

<script type="application/json" id="star-map-payload" set:html={payloadJson} />

<template data-bob-list-item-template>
  <li>
    <span data-label></span>
  </li>
</template>

<style is:global>
  /*
   * Visual chrome closely follows thunfischtoast/bobiverse-map (CC BY-SA 4.0),
   * adapted for our Layout header + BookToggle + system panel.
   */
  .star-map-app {
    --sm-bg: #0a0e1a;
    --sm-panel: #0d1120;
    --sm-bar: #12162a;
    --sm-line: #1e2440;
    --sm-ink: #c8cad0;
    --sm-muted: #5a6a8a;
    --sm-faint: #3a5070;
    --sm-accent: #7ea8e0;
    --sm-year: #e0c878;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--sm-bg);
    color: var(--sm-ink);
    font-family: Consolas, Monaco, ui-monospace, monospace;
    overflow: hidden;
  }

  .star-map-app .top-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
    padding: 8px 16px;
    background: var(--sm-bar);
    border-bottom: 1px solid var(--sm-line);
  }
  .star-map-app .top-bar h1 {
    margin: 0;
    font-size: 14px;
    font-weight: normal;
    color: var(--sm-accent);
  }
  .star-map-app .year-display {
    font-size: 22px;
    font-weight: bold;
    color: var(--sm-year);
    letter-spacing: 1px;
  }
  .star-map-app .layout-btn,
  .star-map-app .about-btn {
    background: #1a2040;
    border: 1px solid #2a3a60;
    color: #5a7aaa;
    padding: 3px 10px;
    font-size: 10px;
    cursor: pointer;
    border-radius: 3px;
    font-family: inherit;
  }
  .star-map-app .layout-btn:hover,
  .star-map-app .about-btn:hover {
    border-color: var(--sm-accent);
    color: var(--sm-accent);
  }
  .star-map-app .top-bar-right {
    margin-left: auto;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Soften BookToggle into the reference chrome */
  .star-map-app .book-toggle {
    border-color: #2a3a60;
    background: #1a2040;
  }
  .star-map-app .book-toggle__btn {
    font-size: 11px;
    padding: 3px 8px;
  }

  .star-map-app .about-panel {
    position: absolute;
    top: 3.25rem;
    right: 1rem;
    z-index: 40;
    width: min(22rem, calc(100vw - 2rem));
    padding: 12px;
    background: #12162a;
    border: 1px solid #2a3a60;
    border-radius: 6px;
    font-size: 11px;
    line-height: 1.5;
    color: var(--sm-muted);
  }
  .star-map-app .about-panel a {
    color: var(--sm-accent);
  }
  .star-map-app .about-panel.hidden {
    display: none;
  }
  .star-map-app .faint {
    color: var(--sm-faint);
  }

  .star-map-app .main {
    display: flex;
    flex: 1;
    min-height: 0;
  }
  .star-map-app .map-container {
    flex: 1;
    position: relative;
    min-width: 0;
  }
  .star-map-app canvas {
    display: block;
    width: 100%;
    height: 100%;
    cursor: grab;
  }
  .star-map-app canvas:active {
    cursor: grabbing;
  }

  .star-map-app .tooltip {
    position: absolute;
    background: #1a2040;
    border: 1px solid #2a3a60;
    padding: 8px 10px;
    border-radius: 4px;
    font-size: 11px;
    pointer-events: none;
    display: none;
    z-index: 10;
    max-width: 260px;
    line-height: 1.5;
  }
  .star-map-app .legend {
    position: absolute;
    bottom: 8px;
    left: 8px;
    font-size: 10px;
    color: #4a5a7a;
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
  }

  .star-map-app .side-column {
    width: 300px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    background: var(--sm-panel);
    border-left: 1px solid var(--sm-line);
    min-height: 0;
  }
  .star-map-app .event-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }
  .star-map-app .event-panel h2,
  .star-map-app .system-panel .eyebrow {
    font-size: 12px;
    color: var(--sm-muted);
    padding: 10px 12px 6px;
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0;
  }
  .star-map-app .event-panel h2 {
    border-bottom: 1px solid #1a1f35;
  }
  .star-map-app .event-log {
    flex: 1;
    overflow-y: auto;
    padding: 6px 0;
  }
  .star-map-app .event-log::-webkit-scrollbar {
    width: 4px;
  }
  .star-map-app .event-log::-webkit-scrollbar-thumb {
    background: #2a3050;
    border-radius: 2px;
  }
  .star-map-app .event-item {
    padding: 5px 12px;
    font-size: 11px;
    line-height: 1.4;
    border-left: 2px solid transparent;
  }
  .star-map-app .event-item.active {
    background: #141a30;
    border-left-color: var(--sm-year);
    color: #e8e8e8;
  }
  .star-map-app .event-item.past {
    color: #4a5068;
  }
  .star-map-app .event-item.future {
    color: #2a3048;
  }
  .star-map-app .event-year {
    color: var(--sm-accent);
    margin-right: 6px;
    font-size: 10px;
  }
  .star-map-app .event-bob {
    color: #c8a0e0;
  }
  .star-map-app .event-destroyed {
    color: #e07878;
  }

  .star-map-app .system-panel {
    border-top: 1px solid var(--sm-line);
    padding: 10px 12px 12px;
    max-height: 0;
    overflow: hidden;
    opacity: 0;
    transition:
      max-height 180ms ease,
      opacity 160ms ease,
      padding 160ms ease;
  }
  .star-map-app .system-panel[data-open="true"] {
    max-height: 240px;
    opacity: 1;
    overflow-y: auto;
  }
  .star-map-app .system-panel-header {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .star-map-app .system-panel h2 {
    margin: 2px 0 0;
    font-size: 14px;
    font-weight: normal;
    color: #e8e8e8;
  }
  .star-map-app .system-panel .distance {
    margin: 2px 0 0;
    font-size: 11px;
    color: var(--sm-muted);
  }
  .star-map-app .system-panel .description {
    margin: 8px 0;
    font-size: 11px;
    line-height: 1.45;
    color: #8090b0;
  }
  .star-map-app .system-panel ul {
    margin: 4px 0 0;
    padding-left: 1.1rem;
    font-size: 11px;
    color: #c8cad0;
  }
  .star-map-app .close-btn {
    background: none;
    border: none;
    color: var(--sm-muted);
    cursor: pointer;
    font-size: 14px;
  }

  .star-map-app .timeline {
    height: 56px;
    background: var(--sm-panel);
    border-top: 1px solid var(--sm-line);
    padding: 8px 16px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .star-map-app .timeline label {
    font-size: 11px;
    color: var(--sm-muted);
  }
  .star-map-app .timeline input[type="range"] {
    flex: 1;
    -webkit-appearance: none;
    appearance: none;
    height: 6px;
    background: #1a2040;
    border-radius: 3px;
    outline: none;
    cursor: pointer;
  }
  .star-map-app .timeline input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--sm-year);
    cursor: grab;
    border: 2px solid #0a0e1a;
  }
  .star-map-app .timeline input[type="range"]::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--sm-year);
    cursor: grab;
    border: 2px solid #0a0e1a;
  }
  .star-map-app .timeline button {
    background: none;
    border: 1px solid #3a4060;
    color: var(--sm-accent);
    padding: 4px 12px;
    font-size: 11px;
    cursor: pointer;
    border-radius: 3px;
    font-family: inherit;
  }
  .star-map-app .timeline button:hover {
    border-color: var(--sm-accent);
  }
  .star-map-app .speed-display {
    font-size: 10px;
    color: var(--sm-muted);
  }

  @media (max-width: 720px) {
    .star-map-app .main {
      flex-direction: column;
    }
    .star-map-app .side-column {
      width: 100%;
      height: 38%;
      border-left: none;
      border-top: 1px solid var(--sm-line);
    }
    .star-map-app .top-bar {
      flex-wrap: wrap;
      gap: 8px;
    }
    .star-map-app .top-bar-right {
      margin-left: 0;
      width: 100%;
      justify-content: space-between;
    }
  }
</style>

<script>
  import { StarMapEngine } from "../scripts/star-map-engine";
  import type { SystemDetail } from "../scripts/star-map-engine";

  function readBook(): 1 | 2 {
    const raw = document.documentElement.dataset.book;
    if (raw === "2") return 2;
    try {
      if (localStorage.getItem("bobiverse-book") === "2") return 2;
    } catch {
      /* ignore */
    }
    return 1;
  }

  function init() {
    const root = document.querySelector<HTMLElement>("[data-star-map-app]");
    const raw = document.getElementById("star-map-payload");
    if (!root || !raw) return;

    const payload = JSON.parse(raw.textContent || "{}");
    const panel = root.querySelector<HTMLElement>("[data-system-panel]")!;
    const detailName = root.querySelector<HTMLElement>("[data-detail-name]")!;
    const detailDistance = root.querySelector<HTMLElement>("[data-detail-distance]")!;
    const detailDescription = root.querySelector<HTMLElement>("[data-detail-description]")!;
    const detailBobs = root.querySelector<HTMLElement>("[data-detail-bobs]")!;
    const listTemplate = document.querySelector<HTMLTemplateElement>(
      "[data-bob-list-item-template]",
    )!;
    const aboutBtn = root.querySelector<HTMLButtonElement>("[data-about-btn]")!;
    const aboutPanel = root.querySelector<HTMLElement>("[data-about-panel]")!;

    function fillPanel(detail: SystemDetail | null) {
      if (!detail) {
        panel.dataset.open = "false";
        panel.setAttribute("aria-hidden", "true");
        return;
      }
      detailName.textContent = detail.name;
      detailDistance.textContent = `${detail.distanceLy.toFixed(2)} light-years from Sol`;
      detailDescription.textContent = detail.description;
      detailBobs.replaceChildren();
      if (detail.bobNames.length === 0) {
        const empty = document.createElement("li");
        empty.className = "faint";
        empty.textContent = "No Bobs here in this year";
        detailBobs.appendChild(empty);
      } else {
        for (const name of detail.bobNames) {
          const node = listTemplate.content.cloneNode(true) as DocumentFragment;
          node.querySelector<HTMLElement>("[data-label]")!.textContent = name;
          detailBobs.appendChild(node);
        }
      }
      panel.dataset.open = "true";
      panel.setAttribute("aria-hidden", "false");
    }

    const engine = new StarMapEngine({
      root,
      payload,
      initialBook: readBook(),
      showLyRings: true,
      onSelectSystem: (_id, detail) => fillPanel(detail),
    });

    root.querySelector("[data-drawer-close]")!.addEventListener("click", () => {
      engine.clearSelection();
    });

    aboutBtn.addEventListener("click", (e) => {
      e.stopPropagation();
      aboutPanel.classList.toggle("hidden");
      aboutBtn.setAttribute(
        "aria-expanded",
        aboutPanel.classList.contains("hidden") ? "false" : "true",
      );
    });
    document.addEventListener("click", (e) => {
      const t = e.target as Node;
      if (!aboutPanel.classList.contains("hidden") && !aboutPanel.contains(t) && t !== aboutBtn) {
        aboutPanel.classList.add("hidden");
        aboutBtn.setAttribute("aria-expanded", "false");
      }
    });

    window.addEventListener("bobiverse:book-change", ((e: CustomEvent) => {
      const book = e.detail?.book === 2 ? 2 : 1;
      engine.setBook(book);
    }) as EventListener);

    // Sync once BookToggle has applied localStorage
    engine.setBook(readBook());

    (window as unknown as { __starMapEngine?: StarMapEngine }).__starMapEngine = engine;
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
