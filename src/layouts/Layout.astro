---
/**
 * Shared page shell: head tags, fonts, and a simple header/footer.
 * Used by every page so we don't repeat the chrome.
 */
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Bobiverse Companion",
  description = "An unofficial fan-made companion for Dennis E. Taylor's Bobiverse books, covering books 1–2 so far.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-line/80">
      <div class="mx-auto flex max-w-3xl items-center justify-between gap-4 px-5 py-4 sm:px-6">
        <a href={import.meta.env.BASE_URL} class="font-display text-lg font-semibold tracking-tight text-ink hover:text-accent">
          Bobiverse Companion
        </a>
        <span class="text-xs font-medium uppercase tracking-wider text-ink-faint">
          Books 1–2
        </span>
      </div>
    </header>

    <main class="mx-auto w-full max-w-3xl flex-1 px-5 py-10 sm:px-6 sm:py-14">
      <slot />
    </main>

    <footer class="border-t border-line/80">
      <div class="mx-auto max-w-3xl px-5 py-6 text-sm text-ink-faint sm:px-6">
        <p>
          Unofficial fan project. Not affiliated with Dennis E. Taylor or his publishers.
          Bobiverse is © its respective rights holders.
        </p>
      </div>
    </footer>
  </body>
</html>
