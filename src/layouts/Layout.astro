---
/**
 * Shared page shell: head tags, fonts, and a simple header/footer.
 * Used by every page so we don't repeat the chrome.
 */
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Wider main column for interactive tools like the star map. */
  wide?: boolean;
}

const {
  title = "Bobiverse Companion",
  description = "An unofficial fan-made companion for Dennis E. Taylor's Bobiverse books, covering books 1–2 so far.",
  wide = false,
} = Astro.props;

const homeHref = import.meta.env.BASE_URL;
const starMapHref = `${import.meta.env.BASE_URL}/star-map`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#05070d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} type="image/svg+xml" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Outfit:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col">
    <header class="border-b border-line/80">
      <div
        class:list={[
          "mx-auto flex items-center justify-between gap-4 px-5 py-4 sm:px-6",
          wide ? "max-w-6xl" : "max-w-3xl",
        ]}
      >
        <a href={homeHref} class="font-display text-lg font-semibold tracking-tight text-ink hover:text-accent">
          Bobiverse Companion
        </a>
        <nav class="flex items-center gap-4 text-sm">
          <a href={starMapHref} class="text-ink-muted hover:text-accent">Star map</a>
          <span class="text-xs font-medium uppercase tracking-wider text-ink-faint">
            Books 1–2
          </span>
        </nav>
      </div>
    </header>

    <main
      class:list={[
        "mx-auto w-full flex-1 px-5 py-10 sm:px-6 sm:py-14",
        wide ? "max-w-6xl" : "max-w-3xl",
      ]}
    >
      <slot />
    </main>

    <footer class="border-t border-line/80">
      <div
        class:list={[
          "mx-auto px-5 py-6 text-sm text-ink-faint sm:px-6",
          wide ? "max-w-6xl" : "max-w-3xl",
        ]}
      >
        <p>
          Unofficial fan project. Not affiliated with Dennis E. Taylor or his publishers.
          Bobiverse is © its respective rights holders.
        </p>
      </div>
    </footer>
  </body>
</html>
