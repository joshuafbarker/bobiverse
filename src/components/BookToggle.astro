---
/**
 * Spoiler-safe Book 1 / Book 2 picker.
 *
 * Persists the choice under `bobiverse-book` in localStorage so later pages
 * (timeline, tree, etc.) can share the same preference. Default is Book 1.
 *
 * Lives as a component because the star map needs it now and other pages will
 * reuse the same control + storage key.
 */
---

<div
  class="book-toggle inline-flex rounded-lg border border-line bg-surface p-0.5 text-sm"
  role="group"
  aria-label="Spoiler level by book"
  data-book-toggle
>
  <button
    type="button"
    class="book-toggle__btn rounded-md px-3 py-1.5 font-medium transition-colors"
    data-book-value="1"
    aria-pressed="true"
  >
    Book 1
  </button>
  <button
    type="button"
    class="book-toggle__btn rounded-md px-3 py-1.5 font-medium transition-colors"
    data-book-value="2"
    aria-pressed="false"
  >
    Book 2
  </button>
</div>

<style>
  .book-toggle__btn {
    color: var(--ink-faint);
  }
  .book-toggle__btn[aria-pressed="true"] {
    background: var(--accent-soft);
    color: var(--accent);
  }
</style>

<script>
  /**
   * Shared book preference: read/write `bobiverse-book` and sync every toggle
   * on the page. Other page scripts listen for `bobiverse:book-change`.
   */
  const STORAGE_KEY = "bobiverse-book";

  function readStoredBook(): 1 | 2 {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (raw === "2") return 2;
    } catch {
      // private mode / blocked storage — stay on the safe default
    }
    return 1;
  }

  function writeStoredBook(book: 1 | 2) {
    try {
      localStorage.setItem(STORAGE_KEY, String(book));
    } catch {
      // ignore
    }
  }

  function applyBook(book: 1 | 2) {
    document.documentElement.dataset.book = String(book);
    for (const root of document.querySelectorAll("[data-book-toggle]")) {
      for (const btn of root.querySelectorAll<HTMLButtonElement>("[data-book-value]")) {
        const value = Number(btn.dataset.bookValue) as 1 | 2;
        btn.setAttribute("aria-pressed", value === book ? "true" : "false");
      }
    }
    window.dispatchEvent(
      new CustomEvent("bobiverse:book-change", { detail: { book } }),
    );
  }

  function init() {
    const initial = readStoredBook();
    applyBook(initial);

    for (const root of document.querySelectorAll("[data-book-toggle]")) {
      root.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        const btn = target?.closest<HTMLButtonElement>("[data-book-value]");
        if (!btn) return;
        const book = Number(btn.dataset.bookValue) as 1 | 2;
        if (book !== 1 && book !== 2) return;
        writeStoredBook(book);
        applyBook(book);
      });
    }
  }

  init();
  document.addEventListener("astro:page-load", init);
</script>
